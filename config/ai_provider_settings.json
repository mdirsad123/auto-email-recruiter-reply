{
  "_comment": "Which providers run is decided ONLY by the .env flags USE_CLAUDE_API, USE_CHATGPT_API, USE_CLAUDE_WEB and USE_CHATGPT_WEB, always in the fixed order Claude API -> ChatGPT API -> Claude Web -> ChatGPT Web. This file only holds models, retry tuning and browser selectors.",
  "retry": {
    "api_max_retries": 2,
    "initial_delay_seconds": 2.0,
    "max_delay_seconds": 10.0,
    "web_max_retries": 0
  },
  "providers": {
    "cohere_api": {
      "default_model": "command-a-plus-05-2026"
    },
    "claude_api": {
      "model_env": "ANTHROPIC_MODEL",
      "default_model": "claude-opus-5-5",
      "server_side_fallback": true,
      "effort_map": {
        "low": "low",
        "medium": "medium",
        "high": "high"
      }
    },
    "chatgpt_api": {
      "model_env": "OPENAI_MODEL",
      "default_model": "gpt-5",
      "reasoning_effort_map": {
        "low": "low",
        "medium": "medium",
        "high": "high"
      }
    },
    "claude_web": {
      "_comment": "Recruiter e-mail chats use the generic chat-and-read-JSON flow with the selectors below, inside CLAUDE_PROJECT_URL when set.",
      "chat_url_env": "CLAUDE_WEB_GENERIC_CHAT_URL",
      "default_chat_url": "https://claude.ai/new",
      "_project_comment": "Recruiter e-mail chats (classification + reply) are created INSIDE the Claude Project in CLAUDE_PROJECT_URL so they can read the uploaded experience_details.md. Leave CLAUDE_PROJECT_URL empty to use the local excerpts only.",
      "project_url_env": "CLAUDE_PROJECT_URL",
      "project_name_env": "CLAUDE_PROJECT_NAME",
      "verify_knowledge_file_visible": false,
      "response_timeout_seconds": 75,
      "selectors": {
        "composer": [
          "div.ProseMirror[contenteditable='true']",
          "div[contenteditable='true'][role='textbox']",
          "textarea"
        ],
        "file_input": [
          "input[type='file']"
        ],
        "send_button": [
          "button[aria-label='Send message']",
          "button[data-testid='send-button']"
        ],
        "stop_button": [
          "button[aria-label='Stop response']",
          "button[aria-label='Stop']"
        ],
        "assistant_message": [
          "div.font-claude-response",
          "[data-testid='assistant-message']",
          "div[data-is-streaming]"
        ]
      }
    },
    "chatgpt_web": {
      "chat_url_env": "CHATGPT_PROJECT_URL",
      "default_chat_url": "https://chatgpt.com/",
      "_project_comment": "Recruiter e-mail chats are created INSIDE the ChatGPT Project in CHATGPT_PROJECT_URL (e.g. https://chatgpt.com/g/g-p-xxxx-jobbot/project) so they can read the uploaded experience_details.md.",
      "project_url_env": "CHATGPT_PROJECT_URL",
      "project_name_env": "CHATGPT_PROJECT_NAME",
      "verify_knowledge_file_visible": false,
      "response_timeout_seconds": 75,
      "selectors": {
        "composer": [
          "#prompt-textarea",
          "div.ProseMirror[contenteditable='true']",
          "textarea"
        ],
        "file_input": [
          "input[type='file']"
        ],
        "send_button": [
          "button[data-testid='send-button']",
          "button[aria-label='Send prompt']"
        ],
        "stop_button": [
          "button[data-testid='stop-button']",
          "button[aria-label='Stop streaming']"
        ],
        "assistant_message": [
          "div[data-message-author-role='assistant']"
        ]
      }
    }
  },
  "web_unavailable_markers": [
    "usage limit",
    "you've reached",
    "you have reached",
    "rate limit",
    "too many requests",
    "at capacity",
    "temporarily unavailable",
    "something went wrong",
    "network error",
    "try again later",
    "upgrade to continue"
  ]
}
