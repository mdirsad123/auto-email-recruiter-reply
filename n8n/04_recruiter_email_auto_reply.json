    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normalize NEW Gmail Trigger and startup catch-up Gmail GET (raw or simplified).\n// No role keyword gating in n8n: Python owns recruiter/automated classification.\n// Configure label IDs once below, using Gmail Label > Get Many.\nconst LABEL_IDS = {\n  'JobBot/Recruiter/AutoReplied':  'REPLACE_LABEL_ID_AUTOREPLIED',\n  'JobBot/Recruiter/DraftReady':   'REPLACE_LABEL_ID_DRAFTREADY',\n  'JobBot/Recruiter/ManualReview': 'REPLACE_LABEL_ID_MANUALREVIEW',\n  'JobBot/Recruiter/Ignored':      'REPLACE_LABEL_ID_IGNORED',\n};\nconst j = $json;\nconst clean = v => v === undefined || v === null ? '' : String(v);\nconst headerMap = {};\nconst raw = j.payload?.headers || j.headers || {};\nif (Array.isArray(raw)) {\n  for (const h of raw) if (h?.name) headerMap[clean(h.name).toLowerCase()] = clean(h.value);\n} else {\n  for (const [k, v] of Object.entries(raw)) {\n    const key = k.toLowerCase();\n    const s = clean(v);\n    headerMap[key] = s.toLowerCase().startsWith(key+':') ? s.slice(key.length+1).trim() : s;\n  }\n}\nconst fromValue = j.from?.value?.[0];\nconst fromAddr = clean(fromValue?.address || headerMap['from'] || j.From || j.from?.text || j.from).trim();\nconst fromHeader = fromValue?.address ? (fromValue?.name ? `${fromValue.name} <${fromValue.address}>` : fromAddr) : fromAddr;\nconst toText = clean(j.to?.text || headerMap['to'] || j.To || j.to);\nconst subject = clean(j.subject || j.Subject || headerMap['subject']);\nfunction decodeData(data) {\n  try { return Buffer.from(clean(data).replace(/-/g,'+').replace(/_/g,'/'), 'base64').toString('utf8'); }\n  catch { return ''; }\n}\nfunction findParts(node, mime) {\n  if (!node) return '';\n  if (clean(node.mimeType).toLowerCase() === mime && node.body?.data) return decodeData(node.body.data);\n  for (const part of (node.parts || [])) { const found=findParts(part,mime); if(found) return found; }\n  return '';\n}\nfunction stripHtml(html) {\n  return clean(html).replace(/<style[\\s\\S]*?<\\/style>/gi,' ').replace(/<script[\\s\\S]*?<\\/script>/gi,' ')\n                    .replace(/<[^>]+>/g,' ').replace(/&nbsp;/gi,' ').replace(/&amp;/gi,'&')\n                    .replace(/&lt;/gi,'<').replace(/&gt;/gi,'>');\n}\nlet body = clean(j.text || j.textPlain || j.plainText);\nif(!body) body = findParts(j.payload, 'text/plain');\nif(!body) body = decodeData(j.payload?.body?.data);\nif(!body) body = stripHtml(j.html || findParts(j.payload, 'text/html'));\nif(!body) body = clean(j.snippet); // last resort only: snippet is incomplete\nbody = body.replace(/\\r\\n/g,'\\n').slice(0,100000);\nconst headers = {};\nfor (const key of ['auto-submitted','precedence','list-unsubscribe','list-id','x-autoreply',\n                   'x-autorespond','return-path','reply-to','message-id','in-reply-to']) {\n  if (headerMap[key]) headers[key] = headerMap[key];\n}\nconst labelValues = (j.labelIds || []).map(String);\nconst handledLabels = [LABEL_IDS['JobBot/Recruiter/AutoReplied'], LABEL_IDS['JobBot/Recruiter/DraftReady']]\n    .filter(x => x && !String(x).startsWith('REPLACE'));\nconst already_processed_in_gmail = handledLabels.some(x => labelValues.includes(String(x)));\nif(!clean(j.id)) throw new Error('Missing Gmail message id: cannot dedupe safely');\nreturn {json:{message_id:clean(j.id),thread_id:clean(j.threadId || j.id),from:fromHeader,\n  from_address:(fromAddr.match(/<([^>]+)>/)?.[1] || fromAddr),to:toText,subject,body,\n  received_at:clean(j.internalDate || j.date || headerMap['date']),headers,\n  label_ids:LABEL_IDS,already_processed_in_gmail}};\n"
      },
