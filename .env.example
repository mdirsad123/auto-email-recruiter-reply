# =============================================================================
# JobBot Recruiter E-mail Auto-Reply  -  copy to .env and fill in
# =============================================================================

# --- API server --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8090
LOG_LEVEL=INFO

# --- Cohere free-tier (leave actual keys ONLY in your local .env) -------------
# New pipeline: Cohere 1 -> Cohere 2 -> Cohere 3 -> Claude Web -> ChatGPT Web
USE_COHERE_API=true
COHERE_API_KEY=
COHERE_API_KEY2=
COHERE_API_KEY3=
COHERE_MODEL=command-a-plus-05-2026
COHERE_TIMEOUT_SECONDS=20

# --- Other providers (set both API flags false for exactly Cohere -> Web) ----
#   Cohere 1 -> Cohere 2 -> Cohere 3 -> Claude Web -> ChatGPT Web
USE_CLAUDE_API=false
USE_CHATGPT_API=false
USE_CLAUDE_WEB=true
USE_CHATGPT_WEB=true

# API keys (only needed when the matching USE_*_API flag is true)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides (defaults: claude-opus-5-5 / gpt-5)
ANTHROPIC_MODEL=
OPENAI_MODEL=
JOBBOT_AI_MAX_RETRIES=2
JOBBOT_AI_TIMEOUT_SECONDS=120
JOBBOT_AI_ATTEMPT_LOG=true

# --- Browser providers (Claude Web / ChatGPT Web) ----------------------------
CHROME_DEBUGGER_ADDRESS=127.0.0.1:9222
# Chrome is started automatically with this profile if port 9222 is closed
CHROME_AUTO_START=true
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_USER_DATA_DIR=C:\chromedebug
# Projects that hold experience_details.md as Project knowledge
CLAUDE_PROJECT_URL=
CLAUDE_PROJECT_NAME=
CHATGPT_PROJECT_URL=
CHATGPT_PROJECT_NAME=
# Fallback chat URLs when no Project is set
CLAUDE_WEB_GENERIC_CHAT_URL=
# true = a web provider without a Project URL is skipped (router falls back)
RECRUITER_REQUIRE_PROJECT_KNOWLEDGE=false

# --- Recruiter e-mail safety --------------------------------------------------
AUTO_SEND_RECRUITER_REPLY=true
RECRUITER_CONFIDENCE_THRESHOLD=0.90
CANDIDATE_FACTS_PATH=config/experience_details.md
# RECRUITER_EMAIL_TEMPLATE_PATH=config/recruiter_email_template.json
# RECRUITER_KNOWLEDGE_SYNC_PATH=config/knowledge_sync_state.json
# Your own address(es): never reply to yourself
RECRUITER_SELF_ADDRESSES=mdirsadtech7305@gmail.com
RECRUITER_BLOCKED_SENDER_DOMAINS=
RECRUITER_THREAD_COOLDOWN_HOURS=24
RECRUITER_PREFILTER_REQUIRED=true
# RECRUITER_AUTO_SEND_INTENTS=REQUEST_CANDIDATE_DETAILS
# RECRUITER_TARGET_ROLES=aiengineer,awsdataengineer,azuredataengineer,dataengineer,pythondeveloper

# --- Duplicate-protection ledger ---------------------------------------------

RECRUITER_EMAIL_LEDGER_PATH=data/recruiter_email_ledger.json
RECRUITER_PROCESSING_LEASE_MINUTES=120
RECRUITER_SENDER_COOLDOWN_HOURS=72
